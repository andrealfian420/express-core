# Purpose: Bitbucket Pipelines template — verify (build + full test suite, including the
#   migration drift check), build and push the production image to Bitbucket Packages tagged
#   with the commit SHA, then deploy exactly that image to a VPS with scripts/deploy.sh.
# Caller: Bitbucket Pipelines on pushes to main (after copying to bitbucket-pipelines.yml).
# Dependencies: Bitbucket service containers (PostgreSQL, Redis), Docker service, an Alpine
#   step with the OpenSSH client, scripts/deploy.sh, VPS with docker compose, the compose
#   files and .env.
# Main Steps: 1) Verify — npm ci, prisma generate, build, unit/integration/HTTP tests with
#   JUnit and coverage reports; any failure blocks the following steps.
#   2) Build & Push Image (tags: commit SHA, latest). 3) Deploy to VPS: drain, migrate, start,
#   wait for the API and worker health checks.
# Side Effects: Pushes images to the registry, drains and restarts containers and applies
#   migrations on the VPS.
#
# Bitbucket Pipelines: Verify, Build, Push to Bitbucket Packages, Deploy to VPS
#
# Setup:
#   1. Copy to bitbucket-pipelines.yml (remove .example)
#   2. Add these repository variables in Settings → Pipelines → Repository variables:
#      - VPS_HOST: your VPS IP or hostname
#      - VPS_USER: SSH username (must be in docker group)
#      - VPS_SSH_KEY: base64-encoded private SSH key (Secured)
#      - VPS_PORT: SSH port (default 22)
#   3. Update the image name and the deploy path (/opt/your-project) below
#   4. Enable Pipelines in repository settings
#   5. On the VPS, the deploy path holds docker-compose.yml, docker-compose.prod.yml (from the
#      .example; images use ${IMAGE_TAG}) and .env; docker compose must be installed
#
# Rollback: redeploy an earlier production deployment from the Deployments page. It runs that
# commit's deploy step: its image and its scripts/deploy.sh (see the upgrade guide before
# rolling back across a release with new job types).
#
# Notes:
#   - Bitbucket Packages authentication is automatic within pipelines
#   - On VPS, authenticate with: docker login docker.pkg.bitbucket.org -u USERNAME -p APP_PASSWORD
#   - Image URL format: docker.pkg.bitbucket.org/WORKSPACE/REPO/IMAGE_NAME:TAG

image: node:24-slim

definitions:
  services:
    docker:
      memory: 2048
    # Disposable test services; identity must match scripts/test-environment.cjs.
    postgres:
      image: postgis/postgis:18-3.6
      memory: 512
      variables:
        POSTGRES_USER: express_core_test
        POSTGRES_PASSWORD: express_core_test
        POSTGRES_DB: express_core_test
    redis:
      image: redis:8.8.0
      memory: 256

pipelines:
  branches:
    main:
      - step:
          name: Verify (build + tests)
          image: node:24
          services:
            - postgres
            - redis
          caches:
            - node
          script:
            - npm ci
            - npx prisma generate
            - npm run build
            # The Redis service starts without authentication; set the test-only password first.
            - node -e "const R=require('ioredis'); const r=new R(); r.config('SET','requirepass','express_core_test').then(()=>r.quit()).catch(()=>process.exit(1))"
            - export TEST_RESOURCE_OWNER=express-core-test
            - npm run test:ci
          artifacts:
            upload:
              - name: test-reports
                type: scoped
                paths:
                  - test-results/**
                  - coverage/**
                capture-on: always

      - step:
          name: Build & Push Image
          services:
            - docker
          caches:
            - docker
          script:
            - export IMAGE_NAME="docker.pkg.bitbucket.org/$BITBUCKET_WORKSPACE/$BITBUCKET_REPO_SLUG/app"
            # The full commit SHA is the tag the deploy step pins.
            - export IMAGE_TAG="$BITBUCKET_COMMIT"

            # Build production image
            - docker build --target production -t $IMAGE_NAME:$IMAGE_TAG -t $IMAGE_NAME:latest .

            # Push to Bitbucket Packages (auto-authenticated)
            - docker push $IMAGE_NAME:$IMAGE_TAG
            - docker push $IMAGE_NAME:latest

      - step:
          name: Deploy to VPS
          deployment: production
          image: alpine:3.20
          script:
            - apk add --no-cache openssh-client
            - install -m 700 -d ~/.ssh
            - echo "$VPS_SSH_KEY" | base64 -d > ~/.ssh/deploy_key
            - chmod 600 ~/.ssh/deploy_key
            # Pipes this commit's scripts/deploy.sh to the VPS: pull this commit's image, drain
            # the outbox and queues, migrate, start, then wait for the API and worker health.
            - >-
              ssh -i ~/.ssh/deploy_key -p "${VPS_PORT:-22}" -o StrictHostKeyChecking=accept-new
              "$VPS_USER@$VPS_HOST"
              "cd /opt/your-project && IMAGE_TAG=$BITBUCKET_COMMIT DEPLOY_DRAIN=true sh -s"
              < scripts/deploy.sh
