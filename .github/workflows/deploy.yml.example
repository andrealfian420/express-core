# Purpose: GitHub Actions template — verify (build + full test suite, including the migration
#   drift check), build and push the production image to GHCR tagged with the commit SHA, then
#   deploy exactly that image to a VPS with scripts/deploy.sh.
# Caller: GitHub Actions on pushes to main (after copying to .github/workflows/deploy.yml).
# Dependencies: GitHub service containers (PostgreSQL, Redis), docker/* actions, the runner's
#   OpenSSH client, scripts/deploy.sh, VPS with docker compose, the compose files and .env.
# Main Jobs: verify (blocks everything after it), build-and-push, deploy.
# Side Effects: Uploads test reports, pushes images to GHCR, drains and restarts containers
#   and applies migrations on the VPS.
#
# GitHub Actions: Verify, Build, Push to GHCR, Deploy to VPS
#
# Setup:
#   1. Copy to .github/workflows/deploy.yml (remove .example)
#   2. Add these secrets in repo Settings → Secrets → Actions:
#      - VPS_HOST: your VPS IP or hostname
#      - VPS_USER: SSH username (must be in docker group)
#      - VPS_SSH_KEY: private SSH key (ed25519 recommended)
#      - VPS_PORT: SSH port (default 22)
#   3. Update env vars below (IMAGE_NAME, DEPLOY_PATH)
#   4. On the VPS, DEPLOY_PATH holds docker-compose.yml, docker-compose.prod.yml (from the
#      .example; images use ${IMAGE_TAG}) and .env; docker compose must be installed
#
# Rollback: re-run the deploy job of an earlier successful run. It deploys that run's commit
# image with that commit's scripts/deploy.sh (see the upgrade guide before rolling back
# across a release with new job types).

name: Build & Deploy

on:
  push:
    branches: [main]

env:
  REGISTRY: ghcr.io
  IMAGE_NAME: ${{ github.repository }} # e.g., your-org/your-project
  DEPLOY_PATH: /opt/your-project # path on VPS where compose files live

jobs:
  verify:
    runs-on: ubuntu-latest
    permissions:
      contents: read

    # Disposable test services; identity must match scripts/test-environment.cjs.
    services:
      postgres:
        image: postgis/postgis:18-3.6
        env:
          POSTGRES_USER: express_core_test
          POSTGRES_PASSWORD: express_core_test
          POSTGRES_DB: express_core_test
        ports:
          - 5432:5432
        options: >-
          --health-cmd "pg_isready -U express_core_test -d express_core_test"
          --health-interval 2s --health-timeout 3s --health-retries 30
      redis:
        image: redis:8.8.0
        ports:
          - 6379:6379

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 24
          cache: npm

      - name: Install, generate and build
        run: |
          npm ci
          npx prisma generate
          npm run build

      # The Redis service starts without authentication; set the test-only password first.
      - name: Secure test Redis
        run: node -e "const R=require('ioredis'); const r=new R(); r.config('SET','requirepass','express_core_test').then(()=>r.quit()).catch(()=>process.exit(1))"

      - name: Full test suite with coverage
        run: npm run test:ci
        env:
          TEST_RESOURCE_OWNER: express-core-test

      - name: Upload test reports
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: test-reports
          path: |
            test-results/
            coverage/

  build-and-push:
    runs-on: ubuntu-latest
    needs: verify
    permissions:
      contents: read
      packages: write

    outputs:
      image_tag: ${{ steps.meta.outputs.tags }}

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Log in to GHCR
        uses: docker/login-action@v3
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Extract metadata
        id: meta
        uses: docker/metadata-action@v5
        with:
          images: ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}
          # The full commit SHA is the tag the deploy job pins.
          tags: |
            type=sha,prefix=,format=long
            type=raw,value=latest

      - name: Build and push
        uses: docker/build-push-action@v6
        with:
          context: .
          target: production
          push: true
          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}
          cache-from: type=gha
          cache-to: type=gha,mode=max

  deploy:
    runs-on: ubuntu-latest
    needs: build-and-push
    permissions:
      contents: read

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      # Pipes this commit's scripts/deploy.sh to the VPS: pull this commit's image, drain the
      # outbox and queues, migrate, start, then wait for the API and worker health checks.
      - name: Deploy to VPS
        env:
          VPS_HOST: ${{ secrets.VPS_HOST }}
          VPS_USER: ${{ secrets.VPS_USER }}
          VPS_PORT: ${{ secrets.VPS_PORT || 22 }}
          VPS_SSH_KEY: ${{ secrets.VPS_SSH_KEY }}
        run: |
          install -m 700 -d ~/.ssh
          printf '%s\n' "$VPS_SSH_KEY" > ~/.ssh/deploy_key
          chmod 600 ~/.ssh/deploy_key
          ssh -i ~/.ssh/deploy_key -p "$VPS_PORT" -o StrictHostKeyChecking=accept-new \
            "$VPS_USER@$VPS_HOST" \
            "cd '${{ env.DEPLOY_PATH }}' && IMAGE_TAG='${{ github.sha }}' DEPLOY_DRAIN=true sh -s" \
            < scripts/deploy.sh
