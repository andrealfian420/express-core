# Purpose: GitHub Actions template — verify (build + full test suite), build and push the
#   production image to GHCR, then deploy to a VPS with Docker Compose.
# Caller: GitHub Actions on pushes to main (after copying to .github/workflows/deploy.yml).
# Dependencies: GitHub service containers (PostgreSQL, Redis), docker/* actions,
#   appleboy/ssh-action, VPS with docker compose and the project's .env.
# Main Jobs: verify (blocks everything after it), build-and-push, deploy.
# Side Effects: Uploads test reports, pushes images to GHCR, restarts containers on the VPS.
#
# GitHub Actions: Verify, Build, Push to GHCR, Deploy to VPS
#
# Setup:
#   1. Copy to .github/workflows/deploy.yml (remove .example)
#   2. Add these secrets in repo Settings → Secrets → Actions:
#      - VPS_HOST: your VPS IP or hostname
#      - VPS_USER: SSH username (must be in docker group)
#      - VPS_SSH_KEY: private SSH key (ed25519 recommended)
#      - VPS_PORT: SSH port (default 22)
#   3. Update env vars below (IMAGE_NAME, DEPLOY_PATH)
#   4. Ensure VPS has docker compose + the project's compose files + .env

name: Build & Deploy

on:
  push:
    branches: [main]

env:
  REGISTRY: ghcr.io
  IMAGE_NAME: ${{ github.repository }} # e.g., your-org/your-project
  DEPLOY_PATH: /opt/your-project # path on VPS where compose files live

jobs:
  verify:
    runs-on: ubuntu-latest
    permissions:
      contents: read

    # Disposable test services; identity must match scripts/test-environment.cjs.
    services:
      postgres:
        image: postgis/postgis:18-3.6
        env:
          POSTGRES_USER: express_core_test
          POSTGRES_PASSWORD: express_core_test
          POSTGRES_DB: express_core_test
        ports:
          - 5432:5432
        options: >-
          --health-cmd "pg_isready -U express_core_test -d express_core_test"
          --health-interval 2s --health-timeout 3s --health-retries 30
      redis:
        image: redis:8.8.0
        ports:
          - 6379:6379

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 24
          cache: npm

      - name: Install, generate and build
        run: |
          npm ci
          npx prisma generate
          npm run build

      # The Redis service starts without authentication; set the test-only password first.
      - name: Secure test Redis
        run: node -e "const R=require('ioredis'); const r=new R(); r.config('SET','requirepass','express_core_test').then(()=>r.quit()).catch(()=>process.exit(1))"

      - name: Full test suite with coverage
        run: npm run test:ci
        env:
          TEST_RESOURCE_OWNER: express-core-test

      - name: Upload test reports
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: test-reports
          path: |
            test-results/
            coverage/

  build-and-push:
    runs-on: ubuntu-latest
    needs: verify
    permissions:
      contents: read
      packages: write

    outputs:
      image_tag: ${{ steps.meta.outputs.tags }}

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Log in to GHCR
        uses: docker/login-action@v3
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Extract metadata
        id: meta
        uses: docker/metadata-action@v5
        with:
          images: ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}
          tags: |
            type=sha,prefix=
            type=raw,value=latest

      - name: Build and push
        uses: docker/build-push-action@v6
        with:
          context: .
          target: production
          push: true
          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}
          cache-from: type=gha
          cache-to: type=gha,mode=max

  deploy:
    runs-on: ubuntu-latest
    needs: build-and-push

    steps:
      - name: Deploy to VPS
        uses: appleboy/ssh-action@v1
        with:
          host: ${{ secrets.VPS_HOST }}
          username: ${{ secrets.VPS_USER }}
          key: ${{ secrets.VPS_SSH_KEY }}
          port: ${{ secrets.VPS_PORT || 22 }}
          script: |
            cd ${{ env.DEPLOY_PATH }}

            # Load environment variables (for PORT)
            set -a && source .env && set +a

            # Pull latest images
            docker compose -f docker-compose.yml -f docker-compose.prod.yml pull

            # Restart services
            docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d

            # Wait for health check (max 60s)
            echo "Waiting for health check on port ${PORT:-3001}..."
            for i in $(seq 1 12); do
              if curl -sf http://localhost:${PORT:-3001}/api/v1/health/ready > /dev/null 2>&1; then
                echo "Health check passed"
                exit 0
              fi
              echo "  Attempt $i/12 - waiting 5s..."
              sleep 5
            done

            echo "Health check failed after 60s"
            docker compose -f docker-compose.yml -f docker-compose.prod.yml logs api --tail 20
            exit 1
