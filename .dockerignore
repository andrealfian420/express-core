# Purpose: Exclude local dependencies, secrets and generated test artifacts from the Docker build context.
# Caller: Docker build (Dockerfile stages, docker-compose*.yml builds).
# Dependencies: Test runner output paths.
# Main Functions: Ignore patterns.
# Side Effects: None.
node_modules
dist
.env
.env.*

# Logs
client/storage/logs
*.log

# Git
.git
.gitignore

# IDE
.vscode
.idea
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker
Dockerfile
docker-compose*.yml

# Dev tools
.eslintcache
coverage

# Automated test artifacts
.test-build
test-results
